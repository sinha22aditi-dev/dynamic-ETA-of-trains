# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dynamicrail:dynamicrail@localhost:5432/dynamicrail

# JWT
JWT_SECRET_KEY=change-me-to-a-random-32-byte-value-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML Service (uvicorn api:app, default port 8000)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_SECONDS=5

# Railway data provider
RAILWAY_PROVIDER=replay
REPLAY_TICK_SECONDS=10

# Paths to dataset CSVs (relative to backend/data/ or absolute)
REPLAY_SOURCE_CSV=data/dynamicrail_sequential_simulation.csv
MASTER_CSV=data/railpulse_master_clean.csv
GRAPH_NODES_CSV=data/railway_graph_nodes.csv
GRAPH_EDGES_CSV=data/railway_graph_edges.csv

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Notification thresholds
DEFAULT_MIN_DELAY_CHANGE_THRESHOLD_MINS=5
APPROACHING_DESTINATION_KM=15

# App
APP_ENV=development
LOG_LEVEL=INFO
